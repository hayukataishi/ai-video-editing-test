{
  "$schema": "../../../../packages/manifest/schemas/edit-manifest.schema.json",
  "manifestType": "edit",
  "schemaVersion": "1.0.0",
  "projectId": "my-channel",
  "episodeId": "ep-001",
  "video": {
    "width": 1920,
    "height": 1080,
    "frameRate": {
      "numerator": 30,
      "denominator": 1
    },
    "pixelAspectRatio": 1
  },
  "target": {
    "palmierProject": "my-channel_ep-001",
    "timeline": "main",
    "createIfMissing": true
  },
  "tracks": [
    {
      "id": "main-video",
      "kind": "video",
      "role": "primary",
      "palmierName": "V1_MAIN_HUMAN",
      "order": 10,
      "managed": false,
      "syncLock": true
    },
    {
      "id": "auto-graphics",
      "kind": "video",
      "role": "graphics",
      "palmierName": "V2_AUTO_GRAPHICS",
      "order": 20,
      "managed": true,
      "syncLock": false
    },
    {
      "id": "voice",
      "kind": "audio",
      "role": "voice",
      "palmierName": "A1_VOICE_HUMAN",
      "order": 10,
      "managed": false,
      "syncLock": true
    }
  ],
  "placements": [
    {
      "id": "place-opening-title",
      "source": {
        "type": "content",
        "ref": "opening-title"
      },
      "trackId": "auto-graphics",
      "startFrame": 0,
      "durationFrames": 150,
      "sourceInFrame": 0,
      "layout": {
        "preset": "full-frame",
        "opacity": 1
      },
      "sync": {
        "policy": "strict",
        "allowOverwrite": false,
        "preservePalmierEffects": true
