      "notes": "オープニングタイトル。自動管理TrackでのClip衝突は許可しない。"
    },
    {
      "id": "place-workflow-diagram",
      "source": {
        "type": "content",
        "ref": "workflow-diagram"
      },
      "trackId": "auto-graphics",
      "startFrame": 1260,
      "durationFrames": 240,
      "sourceInFrame": 0,
      "layout": {
        "preset": "picture-in-picture",
        "position": {
          "unit": "normalized",
          "x": 0.76,
          "y": 0.3
        },
        "scale": 0.62,
        "opacity": 1
      },
      "keyframes": [
        {
          "property": "opacity",
          "points": [
            {
              "frameOffset": 0,
              "value": 0,
              "interpolation": "ease-out"
            },
            {
              "frameOffset": 12,
              "value": 1,
              "interpolation": "linear"
            },
            {
              "frameOffset": 228,
              "value": 1,
              "interpolation": "ease-in"
            },
            {
              "frameOffset": 239,
              "value": 0,
              "interpolation": "linear"
            }
          ]
        }
      ],
      "sync": {
        "policy": "placement-only",
        "allowOverwrite": false,
        "preservePalmierEffects": true
      },
      "notes": "話者の顔を避ける右上配置。Palmier側の仕上げEffectは保持する。"
