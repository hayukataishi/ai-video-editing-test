{
  "id": "my-channel-default",
  "name": "My Channel Default",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "frameRate": {
      "numerator": 30,
      "denominator": 1
    }
  },
  "colors": {
    "background": "#07111F",
    "surface": "#10243E",
    "primary": "#55D6BE",
    "accent": "#8BA7FF",
    "text": "#F7FAFF",
    "mutedText": "#B4C4D9"
  },
  "typography": {
    "fontFamily": "Noto Sans JP, sans-serif",
    "titleWeight": 700,
    "bodyWeight": 500
  },
  "layout": {
    "safeZone": {
      "top": 0.08,
      "right": 0.08,
      "bottom": 0.08,
      "left": 0.08,
      "unit": "normalized"
    },
    "grid": 8
  },
  "motion": {
    "enterFrames": 12,
    "exitFrames": 12,
    "easing": "ease-out"
  }
}
