{
  "name": "@studio/manifest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema and semantic validation for the Remotion and Palmier manifests.",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/content-manifest.schema.json": "./schemas/content-manifest.schema.json",
    "./schemas/edit-manifest.schema.json": "./schemas/edit-manifest.schema.json"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
