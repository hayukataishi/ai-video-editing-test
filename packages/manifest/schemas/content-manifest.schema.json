{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.invalid/video-pipeline/content-manifest.schema.json",
  "title": "Remotion Content Manifest",
  "description": "Declares deterministic Remotion rendering intent for an episode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestType",
    "schemaVersion",
    "projectId",
    "episodeId",
    "video",
    "catalog",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "manifestType": {
      "const": "content"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "$ref": "#/$defs/logicalId"
    },
    "episodeId": {
      "$ref": "#/$defs/logicalId"
    },
    "video": {
      "$ref": "#/$defs/videoSpec"
    },
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "themeId": {
      "$ref": "#/$defs/logicalId"
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/logicalId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentItem"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:[\\\\/]).+$"
    },
    "frame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveFrame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "frameRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "$ref": "#/$defs/positiveFrame"
        },
        "denominator": {
          "$ref": "#/$defs/positiveFrame"
        }
      }
    },
    "videoSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "frameRate"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 32768
        },
        "frameRate": {
          "$ref": "#/$defs/frameRate"
        },
        "pixelAspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "revision"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "font",
            "data",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "licenseNote": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "renderSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputFile",
        "container",
        "codec"
      ],
      "properties": {
        "outputFile": {
          "$ref": "#/$defs/relativePath"
        },
        "container": {
          "enum": [
            "mp4",
            "mov",
            "webm",
            "png-sequence"
          ]
        },
        "codec": {
          "enum": [
            "h264",
            "h265",
            "prores",
            "vp8",
            "vp9",
            "png"
          ]
        },
        "alpha": {
          "type": "boolean",
          "default": false
        },
        "audio": {
          "type": "boolean",
          "default": false
        },
        "pixelFormat": {
          "type": "string",
          "minLength": 1
        },
        "proresProfile": {
          "enum": [
            "proxy",
            "light",
            "standard",
            "hq",
            "4444",
            "4444-xq"
          ]
        },
        "overwrite": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "compositionId",
        "durationFrames",
        "props",
        "render"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/logicalId"
        },
        "compositionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "variant": {
          "$ref": "#/$defs/logicalId"
        },
        "durationFrames": {
          "$ref": "#/$defs/positiveFrame"
        },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logicalId"
          },
          "uniqueItems": true
        },
        "render": {
          "$ref": "#/$defs/renderSpec"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
